            "sourceColumn": "EstFerie",
            "summarizeBy": "none"
          },
          {
            "name": "AnneeMois",
            "dataType": "string",
            "type": "calculated",
            "expression": "FORMAT(dim_temps[Date], \"yyyy-MM\")",
            "sortByColumn": "AnneeMoisTri"
          },
          {
            "name": "AnneeMoisTri",
            "dataType": "int64",
            "type": "calculated",
            "expression": "YEAR(dim_temps[Date])*100+MONTH(dim_temps[Date])",
            "isHidden": true
          },
          {
            "name": "OrigineDonnees",
            "dataType": "string",
            "type": "calculated",
            "expression": "IF(dim_temps[Date] <= DATE(2025,4,30), \"Réel\", \"Synthétique / hors historique chargé\")"
          }
        ],
