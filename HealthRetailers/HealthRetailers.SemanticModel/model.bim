    "expressions": [
      {
        "name": "ServeurSQL",
        "kind": "m",
        "expression": "\"localhost\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "BaseDW",
        "kind": "m",
        "expression": "\"DW_Health_Dimensions\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "Atelier1_Pays_Demo",
        "kind": "m",
        "expression": "// Teaching data only: remove duplicate (country, city) pairs.\nlet\n    Source = #table(type table [Country=text, City=text], {\n        {\"France\",\"Paris\"},{\"France\",\"Paris\"},\n        {\"France\",\"Lyon\"},{\"United States\",\"Los Angeles\"},\n        {\"United States\",\"Los Angeles\"},{\"Australia\",\"Melbourne\"},\n        {\"Australia\",\"Melbourne\"}\n    }),\n    PairesUniques = Table.Distinct(Source, {\"Country\",\"City\"})\nin\n    PairesUniques\n"
      },
      {
        "name": "Atelier1_Ventes_Demo",
        "kind": "m",
        "expression": "// Teaching data only. Never apply Table.Skip(2) to the cleaned warehouse.\nlet\n    DonneesPedagogiques = #table(\n        {\"Column1\", \"Column2\", \"Column3\", \"Column4\", \"Column5\", \"Column6\", \"Column7\"},\n        {\n            {null,null,null,null,null,null,null},\n            {null,null,null,null,null,null,null},\n            {\"Trans Date\",\"Product Code\",\"Quantity sold\",\"Value\",\"RetCity\",\"Urgent\",\"Empty\"},\n            {\"2025-01-05\",\"DEMO-001\",\"2\",\"12.50\",\" Paris \",\"No\",null},\n            {\"2025-01-06\",\"DEMO-002\",\"incorrect\",\"9.00\",\"Lyon\",\"No\",null},\n            {\"2025-01-07\",\"DEMO-003\",\"3\",\"8.00\",\"Lille\",\"Yes\",null}\n        }\n    ),\n    LignesSuperieuresSupprimees = Table.Skip(DonneesPedagogiques, 2),\n    EntetesPromues = Table.PromoteHeaders(LignesSuperieuresSupprimees, [PromoteAllScalars=true]),\n    ColonnesUtiles = Table.SelectColumns(EntetesPromues, {\"Trans Date\",\"Product Code\",\"Quantity sold\",\"Value\",\"RetCity\"}),\n    ColonnesRenommees = Table.RenameColumns(ColonnesUtiles, {{\"Trans Date\",\"Transaction Date\"},{\"Value\",\"Sale Price\"},{\"RetCity\",\"Retailer City\"}}),\n    TypesCorrects = Table.TransformColumnTypes(ColonnesRenommees, {{\"Transaction Date\",type date},{\"Product Code\",type text},{\"Quantity sold\",Int64.Type},{\"Sale Price\",Currency.Type},{\"Retailer City\",type text}}, \"en-US\"),\n    SansErreurs = Table.RemoveRowsWithErrors(TypesCorrects, {\"Quantity sold\"}),\n    TextesNettoyes = Table.TransformColumns(SansErreurs, {{\"Retailer City\",Text.Trim,type text}})\nin\n    TextesNettoyes\n"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"ServeurSQL\", \"BaseDW\", \"dim_client\", \"dim_fournisseur\", \"dim_paiement\", \"dim_produit\", \"dim_temps\", \"fait_achats\", \"fait_decaissements\", \"fait_encaissements\", \"fait_stock_actuel\", \"fait_ventes\", \"Mesures\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
