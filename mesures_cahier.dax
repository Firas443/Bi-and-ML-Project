// 01 Ventes
// Cahier §6/12 : CA net HT chargé par SSIS, retours inclus, sans double comptage.
CA HT =
SUM(fait_ventes[CA_HT])

// 01 Ventes
// 
Quantite vendue =
SUM(fait_ventes[QuantiteVendue])

// 01 Ventes
// 
Nombre de ventes =
DISTINCTCOUNT(fait_ventes[Document_Id])

// 01 Ventes
// 
Panier moyen =
DIVIDE([CA HT], [Nombre de ventes])

// 01 Ventes
// 
CA mois precedent =
IF(HASONEVALUE(dim_temps[AnneeMois]), CALCULATE([CA HT], DATEADD(dim_temps[Date], -1, MONTH)))

// 01 Ventes
// Cahier : (CA N - CA N-1) / CA N-1 ; N = mois. BLANK si période de comparaison absente ou nulle. Comparer des mois complets ; septembre 2024 est partiel.
Croissance CA MoM =
VAR Precedent = [CA mois precedent] RETURN IF(NOT ISBLANK([CA HT]) && NOT ISBLANK(Precedent), DIVIDE([CA HT]-Precedent, Precedent))

// 01 Ventes
// 
CA annee precedente =
IF(HASONEVALUE(dim_temps[AnneeMois]), CALCULATE([CA HT], DATEADD(dim_temps[Date], -1, YEAR)))

// 01 Ventes
// 
Croissance CA YoY =
VAR Precedent = [CA annee precedente] RETURN IF(NOT ISBLANK([CA HT]) && NOT ISBLANK(Precedent), DIVIDE([CA HT]-Precedent, Precedent))

// 01 Ventes
// 
Cout HT connu =
SUM(fait_ventes[Cout_HT])

// 01 Ventes
// 
CA avec cout connu =
CALCULATE([CA HT], KEEPFILTERS(NOT ISBLANK(fait_ventes[Cout_HT])))

// 01 Ventes
// Cahier §12 : seules les lignes dont le coût est connu entrent dans les deux termes de la marge.
Marge HT =
SUMX(FILTER(fait_ventes, NOT ISBLANK(fait_ventes[Cout_HT])), fait_ventes[CA_HT]-fait_ventes[Cout_HT])

// 07 Qualite
// 
Lignes sans cout =
COUNTROWS(FILTER(fait_ventes, ISBLANK(fait_ventes[Cout_HT])))

// 07 Qualite
// 
Couverture cout =
DIVIDE(COUNTROWS(FILTER(fait_ventes, NOT ISBLANK(fait_ventes[Cout_HT]))), COUNTROWS(fait_ventes))

// 02 Clients
// Clients identifiés ayant au moins une ligne de vente dans le contexte courant ; comptoir exclu.
Clients actifs =
CALCULATE(DISTINCTCOUNT(fait_ventes[Company_Id]), KEEPFILTERS(dim_client[EstClientIdentifie] = TRUE()))

// 02 Clients
// 
CA clients identifies =
CALCULATE([CA HT], KEEPFILTERS(dim_client[EstClientIdentifie] = TRUE()))

// 02 Clients
// 
Ventes clients identifies =
CALCULATE([Nombre de ventes], KEEPFILTERS(dim_client[EstClientIdentifie] = TRUE()))

// 02 Clients
// 
Panier clients identifies =
DIVIDE([CA clients identifies], [Ventes clients identifies])

// 02 Clients
// 
Frequence achat client =
DIVIDE([Ventes clients identifies], [Clients actifs])

// 03 Stock
// Snapshot actuel non daté dans le DW ; non additif dans le temps. Pas de relation temporelle inventée.
Stock disponible =
SUM(fait_stock_actuel[QuantiteActuelle])

// 03 Stock
// 
Produits en rupture =
CALCULATE(DISTINCTCOUNT(fait_stock_actuel[Product_Id]), KEEPFILTERS(fait_stock_actuel[QuantiteActuelle] = 0))

// 03 Stock
// 
Produits en stock faible =
COUNTROWS(FILTER(fait_stock_actuel, fait_stock_actuel[QuantiteActuelle] > 0 && NOT ISBLANK(fait_stock_actuel[QuantiteAlerte]) && fait_stock_actuel[QuantiteActuelle] <= fait_stock_actuel[QuantiteAlerte]))

// 07 Qualite
// 
Produits sans seuil =
COUNTROWS(FILTER(fait_stock_actuel, ISBLANK(fait_stock_actuel[QuantiteAlerte])))

// 04 Paiements
// 
Montant encaisse =
SUM(fait_encaissements[Amount])

// 04 Paiements
// 
Montant paye aux fournisseurs =
SUM(fait_decaissements[Amount])

// 04 Paiements
// 
Tresorerie nette =
[Montant encaisse] - [Montant paye aux fournisseurs]

// 04 Paiements
// 
Nombre encaissements =
DISTINCTCOUNT(fait_encaissements[Payment_Id])

// 04 Paiements
// 
Nombre decaissements =
DISTINCTCOUNT(fait_decaissements[Payment_Id])

// 04 Paiements
// DISTINCTCOUNT logique de Payment_Id sur les deux faits ; les imputations ne sont pas des paiements supplémentaires.
Nombre de paiements =
COUNTROWS(DISTINCT(UNION(SELECTCOLUMNS(fait_encaissements, "Payment", fait_encaissements[Payment_Id]), SELECTCOLUMNS(fait_decaissements, "Payment", fait_decaissements[Payment_Id]))))

// 05 Reglements documents
// Imputations des documents de vente visibles ; ne pas sommer après répétition par ligne produit. La période filtre la date de paiement et de vente.
Montant regle vente =
CALCULATE([Montant encaisse], KEEPFILTERS(TREATAS(VALUES(fait_ventes[Document_Id]), fait_encaissements[Document_Id])))

// 05 Reglements documents
// 
Montant regle facture fournisseur =
CALCULATE([Montant paye aux fournisseurs], KEEPFILTERS(TREATAS(VALUES(fait_achats[Document_Id]), fait_decaissements[Document_Id])))

// 07 Qualite
// 
Encaissements non affectes =
CALCULATE([Montant encaisse], KEEPFILTERS(ISBLANK(fait_encaissements[Document_Id])))

// 07 Qualite
// 
Decaissements non affectes =
CALCULATE([Montant paye aux fournisseurs], KEEPFILTERS(ISBLANK(fait_decaissements[Document_Id])))

// 06 Achats
// 
Achats HT =
SUM(fait_achats[MontantAchat_HT])

// 06 Achats
// 
Quantite achetee =
SUM(fait_achats[QuantiteAchetee])

// 06 Achats
// 
Nombre factures fournisseurs =
DISTINCTCOUNT(fait_achats[Document_Id])

// 07 Qualite
// 
Derniere date ventes =
MAXX(ALL(fait_ventes), RELATED(dim_temps[Date]))