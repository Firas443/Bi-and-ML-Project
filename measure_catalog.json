  {
    "name": "CA mois precedent",
    "displayFolder": "01 Ventes",
    "expression": "IF(HASONEVALUE(dim_temps[AnneeMois]), CALCULATE([CA HT], DATEADD(dim_temps[Date], -1, MONTH)))",
    "formatString": "#,0.00",
    "lineageTag": "924cd3b7-abee-4397-b08f-904eedd700d9"
  },
  {
    "name": "Croissance CA MoM",
    "description": "Cahier : (CA N - CA N-1) / CA N-1 ; N = mois. BLANK si période de comparaison absente ou nulle. Comparer des mois complets ; septembre 2024 est partiel.",
    "displayFolder": "01 Ventes",
    "expression": "VAR Precedent = [CA mois precedent] RETURN IF(NOT ISBLANK([CA HT]) && NOT ISBLANK(Precedent), DIVIDE([CA HT]-Precedent, Precedent))",
    "formatString": "0.00%;-0.00%;0.00%",
    "lineageTag": "64622dad-8d9a-4f1a-836c-1121322092c7"
  },
  {
    "name": "CA annee precedente",
    "displayFolder": "01 Ventes",
    "expression": "IF(HASONEVALUE(dim_temps[AnneeMois]), CALCULATE([CA HT], DATEADD(dim_temps[Date], -1, YEAR)))",
    "formatString": "#,0.00",
    "lineageTag": "f978e0f7-16d9-4cbc-935f-739b630fc146"
  },
  {
    "name": "Croissance CA YoY",
    "displayFolder": "01 Ventes",
    "expression": "VAR Precedent = [CA annee precedente] RETURN IF(NOT ISBLANK([CA HT]) && NOT ISBLANK(Precedent), DIVIDE([CA HT]-Precedent, Precedent))",
    "formatString": "0.00%;-0.00%;0.00%",
    "lineageTag": "47f48206-9fab-4ea3-a762-d4d070651be7"
  },
  {
